# Radar de Valorización Urbana — Environment Configuration

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
OUTPUTS_DIR=outputs

# H3 Configuration
H3_RESOLUTION=8

# Model
MODEL_TYPE=lightgbm
RANDOM_SEED=42
CV_FOLDS=5

# Satellite
SATELLITE_PATCH_SIZE=128
SATELLITE_BANDS=3

# Logging
LOG_LEVEL=INFO
